BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "DSPROD01"
   ToolInstanceID "WAREHOUSE"
END HEADER
BEGIN DSJOB
   Identifier "LoadCustomerDim"
   DateModified "2019-04-11"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "LoadCustomerDim"
      Description "Load customer dimension from ODS extract"
      JobVersion "57.0.0"
      BEGIN DSSUBRECORD
         Name "pSourceDir"
         Prompt "Source directory"
         Default "/data/ods"
         ParamType "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "pLoadDate"
         Prompt "Load date"
         Default ""
         ParamType "1"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Name "Read_Customers"
      StageType "PxSequentialFile"
      OutputPins "V0S1P1"
      FileName "customers.csv"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomOutput"
      Name "lnk_raw"
      Partner "V0S2|V0S2P1"
      BEGIN DSSUBRECORD
         Name "customer_id"
         SqlType "4"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "first_name"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "last_name"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "email"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "status"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "balance"
         SqlType "2"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CTransformerStage"
      Name "Xfm_Clean"
      StageType "CTransformerStage"
      InputPins "V0S2P1"
      OutputPins "V0S2P2"
      BEGIN DSSUBRECORD
         Name "StageVar1"
         Derivation "StageVar1 + 1"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CTrxInput"
      Name "lnk_raw"
      Partner "V0S1|V0S1P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P2"
      OLEType "CTrxOutput"
      Name "lnk_clean"
      Partner "V0S3|V0S3P1"
      Constraint "lnk_raw.status = \"ACTIVE\""
      BEGIN DSSUBRECORD
         Name "customer_id"
         Derivation "lnk_raw.customer_id"
         SqlType "4"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "full_name"
         Derivation "Trim(lnk_raw.first_name) : \" \" : Trim(lnk_raw.last_name)"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "email"
         Derivation "DownCase(lnk_raw.email)"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "balance_band"
         Derivation "If lnk_raw.balance > 10000 Then \"GOLD\" Else \"STD\""
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "balance"
         Derivation "lnk_raw.balance"
         SqlType "2"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CAggregatorStage"
      Name "Agg_ByBand"
      StageType "PxAggregator"
      InputPins "V0S3P1"
      OutputPins "V0S3P2"
      BEGIN DSSUBRECORD
         Name "balance_band"
         Grouping "1"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P1"
      OLEType "CAggregatorInput"
      Name "lnk_clean"
      Partner "V0S2|V0S2P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P2"
      OLEType "CAggregatorOutput"
      Name "lnk_agg"
      Partner "V0S4|V0S4P1"
      BEGIN DSSUBRECORD
         Name "balance_band"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "customer_count"
         Derivation "Count(lnk_clean.customer_id)"
         SqlType "4"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "total_balance"
         Derivation "Sum(lnk_clean.balance)"
         SqlType "2"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CCustomStage"
      Name "Write_DimCustomer"
      StageType "PxDB2"
      InputPins "V0S4P1"
      TableName "dw.dim_customer_band"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P1"
      OLEType "CCustomInput"
      Name "lnk_agg"
      Partner "V0S3|V0S3P2"
   END DSRECORD
END DSJOB
BEGIN DSJOB
   Identifier "SeqNightlyLoad"
   DateModified "2019-04-11"
   BEGIN DSRECORD
      Identifier "SEQROOT"
      OLEType "CJSSequence"
      Name "SeqNightlyLoad"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "A1"
      OLEType "CJSJobActivity"
      Name "RunLoadCustomerDim"
      JobName "LoadCustomerDim"
      BEGIN DSSUBRECORD
         TriggerType "0"
         Target "A2"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         TriggerType "1"
         Target "A3"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "A2"
      OLEType "CJSExecCommandActivity"
      Name "ArchiveExtract"
      Command "mv /data/ods/customers.csv /data/archive/"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "A3"
      OLEType "CJSNotificationActivity"
      Name "MailOnFailure"
   END DSRECORD
END DSJOB
