<?xml version="1.0"?>
<SAPBW SYSTEM="BW4PROD">
  <INFOOBJECT NAME="0CUSTOMER" TYPE="CHA" DATATYPE="CHAR" LENGTH="10"
              MASTERDATA="X" TEXTS="X" HIERARCHIES="X"
              DESCRIPTION="Customer number">
    <ATTRIBUTE NAME="0COUNTRY"/>
    <ATTRIBUTE NAME="0INDUSTRY"/>
  </INFOOBJECT>
  <INFOOBJECT NAME="0AMOUNT" TYPE="KYF" DATATYPE="CURR" LENGTH="17"
              CURRENCY="0CURRENCY" AGGREGATION="SUM"
              DESCRIPTION="Sales amount"/>
  <INFOOBJECT NAME="0QUANTITY" TYPE="KYF" DATATYPE="QUAN" LENGTH="17"
              UNIT="0UNIT" AGGREGATION="SUM" DESCRIPTION="Quantity"/>
  <ADSO NAME="ZSALES_RAW" DESCRIPTION="Sales acquisition layer">
    <FIELD NAME="DOC_NUMBER" IOBJ="0DOC_NUMBER" TYPE="CHAR" KEY="X"/>
    <FIELD NAME="CUSTOMER" IOBJ="0CUSTOMER" TYPE="CHAR"/>
    <FIELD NAME="AMOUNT" IOBJ="0AMOUNT" TYPE="CURR" AGGREGATION="SUM"/>
    <FIELD NAME="CURRENCY" IOBJ="0CURRENCY" TYPE="CUKY"/>
    <FIELD NAME="QUANTITY" IOBJ="0QUANTITY" TYPE="QUAN"/>
    <FIELD NAME="ORDER_DATE" IOBJ="0CALDAY" TYPE="DATS"/>
    <FIELD NAME="STATUS" IOBJ="ZSTATUS" TYPE="CHAR"/>
  </ADSO>
  <ADSO NAME="ZSALES_CLEAN" DESCRIPTION="Sales harmonized layer">
    <FIELD NAME="DOC_NUMBER" IOBJ="0DOC_NUMBER" TYPE="CHAR" KEY="X"/>
    <FIELD NAME="CUSTOMER" IOBJ="0CUSTOMER" TYPE="CHAR"/>
    <FIELD NAME="AMOUNT" IOBJ="0AMOUNT" TYPE="CURR" AGGREGATION="SUM"/>
    <FIELD NAME="CURRENCY" IOBJ="0CURRENCY" TYPE="CUKY"/>
    <FIELD NAME="REGION" IOBJ="ZREGION" TYPE="CHAR"/>
    <FIELD NAME="LOAD_DATE" IOBJ="0CALDAY" TYPE="DATS"/>
  </ADSO>
  <COMPOSITEPROVIDER NAME="ZCP_SALES" DESCRIPTION="Sales reporting union">
    <PART PROVIDER="ZSALES_CLEAN" TYPE="UNION"/>
    <PART PROVIDER="ZSALES_RAW" TYPE="UNION"/>
  </COMPOSITEPROVIDER>
  <TRANSFORMATION NAME="TR_SALES" SOURCE="ZSALES_RAW" TARGET="ZSALES_CLEAN"
                  DESCRIPTION="Harmonize sales documents">
    <RULE TARGETFIELD="DOC_NUMBER" TYPE="direct" SOURCEFIELDS="DOC_NUMBER"/>
    <RULE TARGETFIELD="CUSTOMER" TYPE="direct" SOURCEFIELDS="CUSTOMER"/>
    <RULE TARGETFIELD="AMOUNT" TYPE="formula" SOURCEFIELDS="AMOUNT"
          FORMULA="amount * 1.0"/>
    <RULE TARGETFIELD="CURRENCY" TYPE="direct" SOURCEFIELDS="CURRENCY"/>
    <RULE TARGETFIELD="LOAD_DATE" TYPE="constant" CONSTANT="20240101"/>
    <RULE TARGETFIELD="REGION" TYPE="routine" SOURCEFIELDS="CUSTOMER">
      SELECT country FROM t005 WHERE land1 = :customer_country.
      LOOP AT lt_regions INTO ls_region.
        IF ls_region-country = ls_data-country.
          rv_region = ls_region-region.
        ENDIF.
      ENDLOOP.
    </RULE>
    <STARTROUTINE>
      DATA: lt_del TYPE STANDARD TABLE OF zsales.
      DELETE source_package WHERE status = 'X'.
      SELECT kunnr, land1 FROM kna1 INTO TABLE @lt_customers
        WHERE loevm = ''.
    </STARTROUTINE>
  </TRANSFORMATION>
  <DTP NAME="DTP_SALES" SOURCE="ZSALES_RAW" TARGET="ZSALES_CLEAN"
       MODE="delta">
    <FILTER FIELD="STATUS" VALUE="A"/>
  </DTP>
  <INFOPACKAGE NAME="IP_SALES" DATASOURCE="2LIS_11_VAHDR">
    <FILTER FIELD="BUKRS" VALUE="1000"/>
  </INFOPACKAGE>
  <PROCESSCHAIN NAME="PC_SALES_DAILY" DESCRIPTION="Daily sales load">
    <PROCESS ID="START" TYPE="TRIGGER"/>
    <PROCESS ID="LOAD_IP" TYPE="LOADING" OBJECT="IP_SALES"
             DESCRIPTION="Load PSA from ECC"/>
    <PROCESS ID="RUN_DTP" TYPE="DTP_LOAD" OBJECT="DTP_SALES"
             DESCRIPTION="Activate to clean layer"/>
    <PROCESS ID="ROLL_ATTR" TYPE="ATTRIBCHANGE" OBJECT="0CUSTOMER"/>
    <PROCESS ID="NOTIFY" TYPE="MAIL" OBJECT="BW_OPS"/>
    <LINK FROM="LOAD_IP" TO="RUN_DTP" KIND="success"/>
    <LINK FROM="RUN_DTP" TO="ROLL_ATTR" KIND="success"/>
    <LINK FROM="RUN_DTP" TO="NOTIFY" KIND="failure"/>
  </PROCESSCHAIN>
  <QUERY NAME="ZQ_SALES_BY_REGION" INFOPROVIDER="ZCP_SALES"
         DESCRIPTION="Sales by region">
    <ROW IOBJ="REGION"/>
    <ROW IOBJ="CUSTOMER"/>
    <KEYFIGURE NAME="AMOUNT" AGGREGATION="SUM"/>
    <KEYFIGURE NAME="QUANTITY" AGGREGATION="SUM"/>
    <FILTER IOBJ="LOAD_DATE" OPERATOR=">=" VALUE="20240101"/>
    <VARIABLE NAME="VAR_REGION" IOBJ="REGION" TYPE="manual"/>
  </QUERY>
  <AUTHORIZATION NAME="Z_REGION_AUTH" IOBJ="ZREGION"
                 RESTRICTION="EMEA,APAC"/>
  <DATASOURCE NAME="2LIS_11_VAHDR" KIND="extractor" DELTA="ABR"
              SOURCEOBJECT="VBAK" DESCRIPTION="Sales order headers">
    <FIELD NAME="VBELN" TYPE="CHAR"/>
    <FIELD NAME="KUNNR" TYPE="CHAR"/>
    <FIELD NAME="NETWR" TYPE="CURR"/>
    <FIELD NAME="WAERK" TYPE="CUKY"/>
    <FIELD NAME="ERDAT" TYPE="DATS"/>
  </DATASOURCE>
</SAPBW>
