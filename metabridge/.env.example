# MetaBridge runtime configuration — copy to `.env` and fill in real values.
# `.env` is gitignored: NEVER commit real credentials.
#
#   cp .env.example .env   &&   edit .env
#
# Used by docker-compose (env_file) and by `docker run --env-file .env`.

# Require an API key on every /api request (recommended).
METABRIDGE_API_KEY=change-me-openssl-rand-hex-24

# Public base URL of this deployment — REQUIRED for links in emails to be
# absolute (password-reset, invites, approvals). Behind a reverse proxy set
# it to the external URL.
METABRIDGE_PUBLIC_URL=https://metabridge.your-domain.example

# --- Outbound email / notifications (Amazon SES SMTP) ----------------------
# From the SES console → SMTP settings. Values are passed literally by
# env_file / --env-file, so special characters ($ | , ?) need no quoting here.
METABRIDGE_SMTP_HOST=email-smtp.<region>.amazonaws.com
METABRIDGE_SMTP_PORT=587
METABRIDGE_SMTP_USER=<SES SMTP username>
METABRIDGE_SMTP_PASSWORD=<SES SMTP password>
# From identity — MUST be under your SES-verified domain.
METABRIDGE_SMTP_FROM=no-reply@your-domain.example
# Optional: display name, TLS mode, master switch.
METABRIDGE_EMAIL_FROM_NAME=MetaBridge
# METABRIDGE_SMTP_STARTTLS=1        # default on (port 587). Use 0 + SSL for 465.
# METABRIDGE_SMTP_SSL=0             # set 1 for implicit TLS on port 465
# METABRIDGE_NOTIFY_EMAIL=1         # master switch; 0 silences all email
# Comma-separated addresses notified on an executed `metabridge deploy --execute`.
# METABRIDGE_DEPLOY_NOTIFY=ops@your-domain.example,lead@your-domain.example
