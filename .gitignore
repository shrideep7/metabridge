.venv/
# secrets / local runtime config — NEVER commit real credentials.
# .env holds SMTP (SES) passwords, API keys, etc.; only the example is tracked.
.env
.env.*
!.env.example
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
metabridge_out/
out*/
.DS_Store
# runtime state dirs created when METABRIDGE_DATA_DIR falls back to "."
/agents/
/marketplace/
/jobs/
temp/
# generated decks & reports (regenerated artifacts — keep source, not binaries)
/reports/*.pptx
/reports/*.xlsx
/reports/*.pdf
docker-compose.dev.yml
# build artifacts — generated by setuptools/pip install -e, never commit
build/
dist/
# golden-file snapshots for the event-pipeline refactor (regenerate with tools/event_golden.py)
.golden/

# Automation Framework (QA only — not committed to repo)
automation_framework/
automation_framework.zip
docs/AUTOMATION_COVERAGE_RECONCILIATION.md
docs/UI_AUTOMATION_COVERAGE.md

# IDE / agent config dirs
.agents/
.claude/

# CI templates (untracked)
.github/

# Generated runtime outputs
governance_out/
scratch/
