{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metabridge-web",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "web.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "metabridge-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "metabridge-frontend-attach",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
